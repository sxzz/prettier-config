{
  "name": "@sxzz/prettier-config",
  "type": "module",
  "version": "2.4.0",
  "description": "Prettier config for @sxzz",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "https://github.com/sxzz/prettier-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxzz/prettier-config.git"
  },
  "bugs": {
    "url": "https://github.com/sxzz/prettier-config/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "eslint --cache",
    "build": "tsdown",
    "format": "prettier -w .",
    "typecheck": "tsrs --fast",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "prettier": "^3.8.0",
    "prettier-plugin-astro": "^0.14.1"
  },
  "peerDependenciesMeta": {
    "prettier-plugin-astro": {
      "optional": true
    }
  },
  "dependencies": {
    "@prettier/plugin-yuku": "^0.0.3"
  },
  "devDependencies": {
    "@sxzz/eslint-config": "^8.9.2",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0",
    "tsdown": "^0.23.7",
    "tsdown-preset-sxzz": "^0.7.1",
    "tsrs": "0.24.0-ts7.1.0-beta",
    "typescript": "^6.0.3"
  },
  "prettier": "./dist/index.mjs"
}
